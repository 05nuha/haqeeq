# Copy to .env.local (Next.js) / .env (scripts). NEVER commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
GEMINI_API_KEY=
GEMINI_MODEL=
DASHBOARD_ADMIN_TOKEN=
PUBLIC_BASE_URL=https://<your-project>.vercel.app   # BASE_URL also accepted
# Local tests only:
SKIP_TWILIO_SIG=
# Optional engine tuning:
HAQEEQ_MATCH_THRESH=12
HAQEEQ_PIXEL_THRESH=55
HAQEEQ_TAMPER_PCT=0.04
# Meta WhatsApp Cloud API (alternative to Twilio; webhook = https://<domain>/api/meta)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
